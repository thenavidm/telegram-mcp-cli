{
  "name": "@thenavidm/telegram-mcp-cli",
  "version": "0.5.0",
  "description": "Telegram MCP server and CLI for Claude Code, Codex and AI agents. 74 tools for chats, history, search, sending, media, contacts, groups, admin, topics, reactions, polls, folders and privacy, on your real Telegram account over MTProto.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "telegram-mcp": "dist/index.js",
    "telegram-cli": "dist/index.js",
    "telegram-mcp-cli": "dist/npx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@thenavidm/slipway": "^0.1.24",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://github.com/thenavidm/telegram-mcp-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/telegram-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/telegram-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "telegram",
    "mtproto",
    "cli",
    "claude",
    "ai-agents"
  ]
}
